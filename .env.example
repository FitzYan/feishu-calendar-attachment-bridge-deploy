# 企业自建应用；仅在服务器填真实值。不要发到聊天，不要提交 Git。
FEISHU_APP_ID=cli_REPLACE_ME
FEISHU_APP_SECRET=REPLACE_ME
# tenant：机器人身份；user：已授权 HR 身份，需要下面的 OAuth 配置
AUTH_MODE=tenant
BITABLE_APP_TOKEN=REPLACE_WITH_BASE_APP_TOKEN
BITABLE_TABLE_ID=tblREPLACE_ME
# 必须填真实 calendar_id，不接受 primary，也不接受参会人的日程副本日历。
ALLOWED_CALENDAR_IDS=["feishu.cn_REPLACE_ME@group.calendar.feishu.cn"]
ATTACHMENT_FIELDS=["候选人简历"]
# 文档冲突：create 写 calendar；patch 写 calender；上传枚举未列出。
# 默认采用 calendar；必须完成测试文件实测。不自动切换。
CALENDAR_PARENT_TYPE=calendar
# 以下三项用 README 中的命令生成；两种 secret 不同且至少 32 字符。
WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
ADMIN_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
DATA_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
DATA_DIR=./data
JOB_RETENTION_DAYS=30
HOST=127.0.0.1
PORT=8080
ALLOW_API_CREATE=false
# 可选：留空表示不写回表格。先在表格手动建立字段；不会自动建字段。
# 状态字段为单选且包含“同步成功”；其他字段为文本。服务只写确认成功状态。
STATUS_FIELD=
JOB_ID_FIELD=
CALENDAR_ID_FIELD=
EVENT_ID_FIELD=
# 推荐 attach 模式填写：必须匹配原生创建后已经保存到该记录的日程 ID/日历 ID。
# 初试和复试分别使用对应字段。留空时仅靠 webhook 密钥及日历白名单验证目标。
BOUND_EVENT_ID_FIELD=
BOUND_CALENDAR_ID_FIELD=
# user 模式：将此固定地址配置到飞书后台重定向 URL；App ID/Secret 必须同一应用。
OAUTH_REDIRECT_URI=https://calendar-bridge.example.com/oauth/callback
# 写回表格时 bitable:app:readonly 改为 bitable:app；API 创建另加 event:create。
OAUTH_SCOPES=bitable:app:readonly docs:document.media:download docs:document.media:upload calendar:calendar:read calendar:calendar.event:read calendar:calendar.event:update offline_access
